# Application
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_BASE_URL=http://127.0.0.1:3000
DATABASE_PATH=./data/private/villa.sqlite
STORAGE_PATH=./storage
COOKIE_SECRET=replace-with-at-least-32-random-characters
OWNER_NAME=Villa Tullia Owner
OWNER_EMAIL=owner@example.com
OWNER_ADDRESS=Replace with the owner's legal address
PROPERTY_LEGAL_NAME=Villa Tullia
PROPERTY_ADDRESS=Replace with the property's full legal address
DEFAULT_CURRENCY=EUR
SIGNING_HOLD_HOURS=72
CALENDAR_AVAILABILITY_URL=https://villa-calendar-sync.lankaswellproject.workers.dev/availability.json
ICAL_FEED_TOKEN=replace-with-a-long-random-calendar-token

# Signing: mock for local development, documenso on the VPS
SIGNING_PROVIDER=mock
DOCUMENSO_BASE_URL=http://documenso:3000/api/v2
DOCUMENSO_API_TOKEN=replace-me
DOCUMENSO_WEBHOOK_SECRET=replace-me

# Payments: mock for local development, stripe after test credentials are supplied
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Bank transfer: shown only when enabled and account holder + IBAN are set
BANK_TRANSFER_ENABLED=false
BANK_ACCOUNT_HOLDER=
BANK_NAME=
BANK_IBAN=
BANK_BIC=

# Email: preview writes messages locally; smtp uses the settings below
EMAIL_PROVIDER=preview
EMAIL_FROM=Villa Tullia <bookings@example.com>
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
