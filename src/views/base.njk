<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <title>{{ title }} | Villa Tullia Admin</title>
  <style>
    :root{--ink:#183632;--forest:#24584f;--terracotta:#b66b4f;--cream:#f7f4ed;--line:#d9ddd6;--muted:#65736e;--green:#287b55;--red:#a13f3f;--amber:#9b6c22}
    *{box-sizing:border-box}body{margin:0;color:var(--ink);background:#f4f1ea;font:15px/1.48 Arial,sans-serif}a{color:var(--forest)}
    header{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:16px max(22px,5vw);color:white;background:var(--ink)}header a{color:white;text-decoration:none}.brand{font:22px Georgia,serif}.brand small{display:block;color:#b9cbc5;font:10px Arial,sans-serif;letter-spacing:.12em;text-transform:uppercase}.header-actions{display:flex;align-items:center;gap:16px}.link-button{padding:0;border:0;background:none;color:inherit;text-decoration:underline;cursor:pointer;font:inherit}
    main{width:min(1180px,calc(100% - 32px));margin:34px auto 70px}.page-head{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:24px}.page-head h1{margin:0;font:36px/1.1 Georgia,serif}.page-head p{margin:7px 0 0;color:var(--muted)}
    .card{padding:22px;background:white;border:1px solid var(--line);box-shadow:0 10px 28px rgba(24,54,50,.06)}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.grid.three{grid-template-columns:repeat(3,minmax(0,1fr))}.stack{display:grid;gap:16px}.span-2{grid-column:1/-1}
    .metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.metric{padding:16px;background:var(--cream);border:1px solid var(--line)}.metric span{display:block;color:var(--muted);font-size:10px;font-weight:bold;letter-spacing:.07em;text-transform:uppercase}.metric strong{display:block;margin-top:5px;font:25px Georgia,serif}.metric.highlight{background:#edf6f0;border-color:#bdd8c7}.metric.highlight strong{color:var(--green)}
    h2{margin:0 0 15px;font:24px Georgia,serif}h3{margin:0 0 10px;font:18px Georgia,serif}.muted{color:var(--muted)}.eyebrow{color:var(--terracotta);font-size:11px;font-weight:bold;letter-spacing:.12em;text-transform:uppercase}
    .button,button.button{display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:10px 15px;border:1px solid var(--forest);background:var(--forest);color:white;text-decoration:none;cursor:pointer;font:700 12px Arial,sans-serif;letter-spacing:.05em}.button.secondary{background:white;color:var(--forest)}.button.terracotta{border-color:var(--terracotta);background:var(--terracotta)}.button.danger{border-color:var(--red);background:var(--red)}.button:disabled{opacity:.45;cursor:not-allowed}.actions{display:flex;flex-wrap:wrap;gap:9px}.inline{display:inline}
    .notice{margin:0 0 18px;padding:13px 16px;border-left:4px solid var(--green);background:#edf6f0}.notice.warn{border-color:var(--amber);background:#fff6df}.notice.error{border-color:var(--red);background:#fff0f0}
    .status{display:inline-block;padding:5px 8px;background:#e8eee9;color:var(--forest);font-size:10px;font-weight:bold;letter-spacing:.07em;text-transform:uppercase}.status.CONFIRMED{background:#dcefe3;color:#17613c}.status.CANCELLED,.status.EXPIRED,.status.PAYMENT_FAILED{background:#f5dddd;color:#8a3030}.status.AWAITING_OWNER_SIGNATURE,.status.AWAITING_GUEST_SIGNATURE,.status.AWAITING_PAYMENT,.status.PAYMENT_PROCESSING{background:#fff0cb;color:#76500e}
    table{width:100%;border-collapse:collapse}th,td{padding:12px 9px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}th{color:var(--muted);font-size:10px;letter-spacing:.08em;text-transform:uppercase}tr:last-child td{border-bottom:0}.table-wrap{overflow-x:auto}
    label{display:block;margin-bottom:6px;color:#53635e;font-size:11px;font-weight:bold;letter-spacing:.06em;text-transform:uppercase}input,select,textarea{width:100%;padding:11px 12px;border:1px solid #cfd5cf;background:white;color:var(--ink);font:inherit}textarea{min-height:100px;resize:vertical}.field{min-width:0}.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.form-grid .wide{grid-column:1/-1}.money-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
    dl{display:grid;grid-template-columns:145px 1fr;gap:8px 14px;margin:0}dt{color:var(--muted)}dd{margin:0;overflow-wrap:anywhere}.timeline{margin:0;padding:0;list-style:none}.timeline li{position:relative;margin-left:8px;padding:0 0 20px 22px;border-left:1px solid var(--line)}.timeline li:before{content:"";position:absolute;left:-5px;top:4px;width:9px;height:9px;border-radius:50%;background:var(--terracotta)}.timeline li:last-child{padding-bottom:0}.timeline strong,.timeline small{display:block}.timeline small{color:var(--muted)}
    .login-shell{width:min(460px,calc(100% - 32px));margin:9vh auto}.login-shell .card{padding:32px}.login-shell h1{font:34px Georgia,serif}.login-shell form{display:grid;gap:16px}.copy-field{display:flex;gap:8px}.copy-field input{font-size:12px}
    @media(max-width:820px){.grid,.grid.three,.form-grid,.money-grid,.metrics{grid-template-columns:1fr}.page-head{align-items:flex-start;flex-direction:column}.span-2,.form-grid .wide{grid-column:auto}header{align-items:flex-start}.header-actions{align-items:flex-end;flex-direction:column}.desktop-only{display:none}dl{grid-template-columns:1fr}dt{font-weight:bold}main{width:min(100% - 22px,1180px);margin-top:20px}.card{padding:17px}}
  </style>
</head>
<body>
  {% if admin %}<header><a class="brand" href="/admin">Villa Tullia<small>Booking administration</small></a><div class="header-actions"><span class="desktop-only">{{ admin.display_name }}</span><form method="post" action="/admin/logout"><input type="hidden" name="_csrf" value="{{ csrf }}"><button class="link-button" type="submit">Sign out</button></form></div></header>{% endif %}
  {% block body %}{% endblock %}
</body>
</html>
