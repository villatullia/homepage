{% extends "base.njk" %}{% block body %}<main>
<div class="page-head"><div><div class="eyebrow">Conversion analytics</div><h1>CRO dashboard</h1><p>Anonymous, privacy-safe funnel performance.</p></div><a class="button secondary" href="/admin">Booking dashboard</a></div>
<div class="stack"><section class="card"><div class="metrics cro-metrics"><div class="metric"><span>Visitors</span><strong>{{ cro.visitors }}</strong></div><div class="metric"><span>Sessions</span><strong>{{ cro.sessions }}</strong></div><div class="metric"><span>Average visit</span><strong>{{ cro.averageVisitDurationFormatted }}</strong></div><div class="metric"><span>Enquiries</span><strong>{{ cro.conversions }}</strong></div><div class="metric highlight"><span>Conversion rate</span><strong>{{ cro.conversionRate }}%</strong></div></div></section>
<section class="card"><div class="page-head compact"><div><h2>Get optimization suggestions</h2><p>Generate a privacy-safe brief from the latest CRO data to paste into ChatGPT.</p></div><button class="button terracotta" id="generateOptimizationPrompt" type="button" aria-controls="optimizationPromptPanel" aria-expanded="false">Generate optimization prompt</button></div><div id="optimizationPromptPanel" hidden><label for="optimizationPrompt">Prompt</label><textarea id="optimizationPrompt" class="prompt-output" readonly>{{ cro.optimizationPrompt }}</textarea><div class="actions"><button class="button" id="copyOptimizationPrompt" type="button">Copy prompt</button><span class="copy-status" id="optimizationPromptStatus" role="status" aria-live="polite"></span></div></div></section>
<section class="card"><h2>Automatic insights</h2><ul>{% for insight in cro.insights %}<li>{{ insight }}</li>{% endfor %}</ul></section>
<section class="card"><div class="page-head"><div><h2>Stay interest</h2><p>Which dates visitors select most often. Repeat selections are counted as clicks; visitors remain anonymous.</p></div></div><div class="interest-grid"><div><h3>Most selected weeks</h3><div class="bar-chart">{% for row in cro.stayInterest.weeks %}<div class="bar-row"><span class="bar-label">{{ row.label }}</span><div class="bar-track" role="img" aria-label="{{ row.label }}: {{ row.clicks }} selections by {{ row.visitors }} visitors"><div class="bar-fill" style="width:{{ row.barPercent }}%"></div></div><span class="bar-value">{{ row.clicks }} click{% if row.clicks != 1 %}s{% endif %} · {{ row.visitors }} visitor{% if row.visitors != 1 %}s{% endif %}</span></div>{% else %}<p class="muted">No week selections yet.</p>{% endfor %}</div></div><div class="interest-summary"><div><h3>Popular months</h3><div class="table-wrap"><table><thead><tr><th>Month</th><th>Clicks</th></tr></thead><tbody>{% for row in cro.stayInterest.months %}<tr><td>{{ row.label }}</td><td>{{ row.clicks }}</td></tr>{% else %}<tr><td colspan="2">No month selections yet</td></tr>{% endfor %}</tbody></table></div></div><div><h3>Popular years</h3><div class="table-wrap"><table><thead><tr><th>Year</th><th>Clicks</th></tr></thead><tbody>{% for row in cro.stayInterest.years %}<tr><td>{{ row.label }}</td><td>{{ row.clicks }}</td></tr>{% else %}<tr><td colspan="2">No year selections yet</td></tr>{% endfor %}</tbody></table></div></div></div></div></section>
<section class="card"><div class="page-head"><div><h2>Homepage behavior</h2><p>{{ cro.homepage.visitors }} visitors · {{ cro.homepage.sessions }} sessions</p></div><div class="metric highlight"><span>Homepage → availability</span><strong>{{ cro.homepage.availabilityRate }}%</strong></div></div>
<div class="grid"><div><h3>CTA click-through</h3><div class="table-wrap"><table><thead><tr><th>Interaction</th><th>Sessions</th><th>CTR</th></tr></thead><tbody>{% for row in cro.homepage.ctas %}<tr><td>{{ row.label | replace('_', ' ') }}</td><td>{{ row.clicks }}</td><td>{{ row.rate }}%</td></tr>{% else %}<tr><td colspan="3">No CTA clicks yet</td></tr>{% endfor %}</tbody></table></div></div>
<div><h3>Scroll depth</h3><div class="table-wrap"><table><thead><tr><th>Depth</th><th>Sessions</th><th>Reached</th></tr></thead><tbody>{% for row in cro.homepage.scroll %}<tr><td>{{ row.milestone }}%</td><td>{{ row.sessions }}</td><td>{{ row.rate }}%</td></tr>{% else %}<tr><td colspan="3">No scroll data yet</td></tr>{% endfor %}</tbody></table></div></div></div></section>
<section class="card"><h2>Key section exposure</h2><p class="muted">Enquiry rate is for visitors who reached the section and later completed an enquiry.</p><div class="table-wrap"><table><thead><tr><th>Section</th><th>Visitors</th><th>Homepage reach</th><th>Later enquiries</th><th>Enquiry rate</th></tr></thead><tbody>{% for row in cro.homepage.sections %}<tr><td>{{ row.section }}</td><td>{{ row.visitors }}</td><td>{{ row.reachRate }}%</td><td>{{ row.conversions }}</td><td>{{ row.conversionRate }}%</td></tr>{% else %}<tr><td colspan="5">No section exposure yet</td></tr>{% endfor %}</tbody></table></div></section>
<section class="card"><h2>Visitors around the world</h2><p class="muted">Darker blue means more visitors. Hover over a country to see its total.</p><div id="countryHeatmap" class="country-map" aria-label="World map showing visitors by country"><div class="country-map-status">Loading visitor map…</div><div id="countryMapTooltip" class="map-tooltip" role="tooltip"></div></div><div class="map-legend" aria-label="Visitor intensity from fewer to more"><span>Fewer</span><span class="map-legend-scale" aria-hidden="true"></span><span>More</span></div><ul id="countryMapData" hidden>{% for row in cro.visitorContext.countries %}{% if row.iso3 %}<li data-iso3="{{ row.iso3 }}" data-country="{{ row.countryName }}" data-visitors="{{ row.visitors }}"></li>{% endif %}{% endfor %}</ul></section>
<section class="card"><h2>Booking journey</h2><p class="muted">Visitors are distinct anonymous users and may return across multiple sessions.</p><div class="table-wrap"><table><thead><tr><th>Step</th><th>Sessions</th><th>Session drop-off</th><th>Visitors</th><th>Visitor drop-off</th></tr></thead><tbody>{% for row in cro.stages %}<tr><td>{{ row.label }}</td><td>{{ row.count }}</td><td>{% if loop.first %}—{% else %}{{ row.dropoff }} ({{ row.dropoffRate }}%){% endif %}</td><td>{{ row.visitors }}</td><td>{% if loop.first %}—{% else %}{{ row.visitorDropoff }} ({{ row.visitorDropoffRate }}%){% endif %}</td></tr>{% endfor %}</tbody></table></div></section>
<section class="card"><h2>Individual visitor paths</h2><p class="muted">Click an anonymous visitor to see every recorded action, grouped by visit. Times are shown in Italy time.</p><div>{% for visitor in cro.visitorJourneys %}<details class="journey"><summary><strong>{{ visitor.label }}{% if visitor.converted %} · Enquired{% endif %}</strong><span class="journey-meta">{{ visitor.sessions | length }} visit{% if visitor.sessions | length != 1 %}s{% endif %} · {{ visitor.eventCount }} actions</span><span class="journey-meta">Last seen {{ visitor.lastSeenFormatted }}</span></summary><div class="journey-body"><p class="journey-context">{{ visitor.country }} · {{ visitor.device }} · {{ visitor.browser }} on {{ visitor.operatingSystem }} · {{ visitor.language }} · {{ visitor.source }}</p>{% for session in visitor.sessions %}<div class="journey-session"><h3>Visit {{ session.number }} <span class="muted">· {{ session.firstSeenFormatted }}</span></h3><ol class="timeline">{% for event in session.events %}<li><strong>{{ event.label }}</strong><small>{{ event.time }}{% if event.page %} · <span class="journey-page">{{ event.page }}</span>{% endif %}</small>{% if event.details %}<small>{{ event.details }}</small>{% endif %}</li>{% endfor %}</ol></div>{% endfor %}</div></details>{% else %}<p class="muted">No visitor paths recorded yet.</p>{% endfor %}</div></section>
<section class="card"><h2>Visitor details</h2><div class="grid"><div><h3>Countries</h3><div class="table-wrap"><table><thead><tr><th>Country</th><th>Visitors</th><th>Enquiry rate</th></tr></thead><tbody>{% for row in cro.visitorContext.countries %}<tr><td>{{ row.label }}</td><td>{{ row.visitors }}</td><td>{{ row.rate }}%</td></tr>{% endfor %}</tbody></table></div></div><div><h3>Browsers</h3><div class="table-wrap"><table><thead><tr><th>Browser</th><th>Visitors</th><th>Enquiry rate</th></tr></thead><tbody>{% for row in cro.visitorContext.browsers %}<tr><td>{{ row.label }}</td><td>{{ row.visitors }}</td><td>{{ row.rate }}%</td></tr>{% endfor %}</tbody></table></div></div><div><h3>Operating systems</h3><div class="table-wrap"><table><thead><tr><th>System</th><th>Visitors</th><th>Enquiry rate</th></tr></thead><tbody>{% for row in cro.visitorContext.operatingSystems %}<tr><td>{{ row.label }}</td><td>{{ row.visitors }}</td><td>{{ row.rate }}%</td></tr>{% endfor %}</tbody></table></div></div><div><h3>Languages</h3><div class="table-wrap"><table><thead><tr><th>Language</th><th>Visitors</th><th>Enquiry rate</th></tr></thead><tbody>{% for row in cro.visitorContext.languages %}<tr><td>{{ row.label }}</td><td>{{ row.visitors }}</td><td>{{ row.rate }}%</td></tr>{% endfor %}</tbody></table></div></div></div></section>
<div class="grid"><section class="card"><h2>Device performance</h2><div class="table-wrap"><table><thead><tr><th>Device</th><th>Sessions</th><th>Enquiries</th><th>Rate</th></tr></thead><tbody>{% for row in cro.devices %}<tr><td>{{ row.label }}</td><td>{{ row.sessions }}</td><td>{{ row.conversions }}</td><td>{{ row.rate }}%</td></tr>{% else %}<tr><td colspan="4">No data yet</td></tr>{% endfor %}</tbody></table></div></section>
<section class="card"><h2>Traffic sources</h2><div class="table-wrap"><table><thead><tr><th>Source / referrer</th><th>Sessions</th><th>Enquiries</th><th>Rate</th></tr></thead><tbody>{% for row in cro.sources %}<tr><td>{{ row.label }}</td><td>{{ row.sessions }}</td><td>{{ row.conversions }}</td><td>{{ row.rate }}%</td></tr>{% else %}<tr><td colspan="4">No data yet</td></tr>{% endfor %}</tbody></table></div></section></div></div></main>
<script>
  (() => {
    const generate = document.getElementById('generateOptimizationPrompt');
    const panel = document.getElementById('optimizationPromptPanel');
    const prompt = document.getElementById('optimizationPrompt');
    const copy = document.getElementById('copyOptimizationPrompt');
    const status = document.getElementById('optimizationPromptStatus');
    const copyPrompt = async () => {
      try {
        await navigator.clipboard.writeText(prompt.value);
        status.textContent = 'Copied to clipboard.';
      } catch {
        prompt.focus();
        prompt.select();
        status.textContent = 'Prompt selected — press Ctrl+C or Cmd+C to copy.';
      }
    };
    generate.addEventListener('click', async () => {
      panel.hidden = false;
      generate.setAttribute('aria-expanded', 'true');
      await copyPrompt();
    });
    copy.addEventListener('click', copyPrompt);
  })();
</script>
<script type="module">
  import * as d3 from 'https://cdn.jsdelivr.net/npm/d3@7.9.0/+esm';
  import { feature } from 'https://cdn.jsdelivr.net/npm/topojson-client@3.1.0/+esm';
  import world from 'https://cdn.jsdelivr.net/npm/@d3-maps/atlas@1.0.0/world/countries/countries-110m/+esm';

  const root = document.getElementById('countryHeatmap');
  const tooltip = document.getElementById('countryMapTooltip');
  const visitorData = new Map([...document.querySelectorAll('#countryMapData li')].map(item => [item.dataset.iso3, { country:item.dataset.country, visitors:Number(item.dataset.visitors) }]));
  const worldFeatures = feature(world, world.objects.features).features;
  const maxVisitors = Math.max(1, ...[...visitorData.values()].map(item => item.visitors));
  const color = d3.scaleSequential([0, maxVisitors], d3.interpolateBlues);

  const drawCountryMap = () => {
    const width = Math.max(320, Math.round(root.getBoundingClientRect().width));
    const height = width < 620 ? 250 : 410;
    root.querySelector('svg')?.remove();
    const svg = d3.select(root).insert('svg', ':first-child').attr('viewBox', `0 0 ${width} ${height}`).attr('role', 'img').attr('aria-labelledby', 'countryMapTitle countryMapDescription');
    svg.append('title').attr('id', 'countryMapTitle').text('Visitors by country');
    svg.append('desc').attr('id', 'countryMapDescription').text('A world heatmap where darker blue countries have more visitors. Exact totals are also listed in the visitor details table.');
    const projection = d3.geoNaturalEarth1().fitExtent([[8, 8], [width - 8, height - 8]], { type:'FeatureCollection', features:worldFeatures });
    const path = d3.geoPath(projection);
    svg.append('g').selectAll('path').data(worldFeatures).join('path')
      .attr('d', path)
      .attr('class', country => visitorData.has(country.properties.id) ? 'has-data' : null)
      .attr('fill', country => { const value = visitorData.get(country.properties.id)?.visitors; return value ? color(value) : '#e8edf2'; })
      .attr('aria-label', country => { const item = visitorData.get(country.properties.id); return item ? `${item.country}: ${item.visitors} visitors` : null; })
      .on('pointerenter', (_event, country) => {
        const item = visitorData.get(country.properties.id);
        if (!item) return;
        tooltip.innerHTML = `<strong>${item.country}</strong>${item.visitors} visitor${item.visitors === 1 ? '' : 's'}`;
        tooltip.style.display = 'block';
      })
      .on('pointermove', event => {
        const bounds = root.getBoundingClientRect();
        tooltip.style.left = `${Math.min(bounds.width - 220, Math.max(8, event.clientX - bounds.left + 12))}px`;
        tooltip.style.top = `${Math.max(8, event.clientY - bounds.top - 48)}px`;
      })
      .on('pointerleave', () => { tooltip.style.display = 'none'; });
    root.querySelector('.country-map-status')?.remove();
  };
  drawCountryMap();
  new ResizeObserver(drawCountryMap).observe(root);
</script>
{% endblock %}
