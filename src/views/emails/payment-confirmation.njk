{% extends "_layout.njk" %}{% block content %}<h1 style="font:26px Georgia,serif">{% if isBalance %}Balance received{% else %}Booking confirmed{% endif %}</h1><p>The {{ paymentLabel }} of <strong>{{ amount }}</strong> for <strong>{{ reference }}</strong> has been verified.{% if not isBalance %} Your stay from {{ checkIn }} to {{ checkOut }} is confirmed.{% endif %}</p><p><a href="{{ guestUrl }}">View booking details</a></p>{% endblock %}
