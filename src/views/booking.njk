{% extends "base.njk" %}
{% block body %}
<main>
  <div class="page-head"><div><div class="eyebrow">{{ booking.reference }}</div><h1>{{ booking.guest.legal_name }}</h1><p>{{ booking.checkInFormatted }} — {{ booking.checkOutFormatted }}</p></div><div class="actions"><span class="status {{ booking.status }}">{{ booking.status }}</span><a class="button secondary" href="/admin">Dashboard</a></div></div>
  {% if created %}<p class="notice">Booking created. Review the details before generating the agreement.</p>{% endif %}{% if message %}<p class="notice">{{ message }}</p>{% endif %}
  <div class="grid">
    <section class="card"><h2>Guest and stay</h2><dl><dt>Legal name</dt><dd>{{ booking.guest.legal_name }}</dd><dt>Email</dt><dd>{{ booking.guest.email }}</dd><dt>Phone</dt><dd>{{ booking.guest.phone }}</dd><dt>Address</dt><dd>{{ booking.guest.address_line1 }}{% if booking.guest.address_line2 %}<br>{{ booking.guest.address_line2 }}{% endif %}<br>{{ booking.guest.postal_code }} {{ booking.guest.city }}<br>{{ booking.guest.country }}</dd><dt>Guests</dt><dd>{{ booking.guests_count }}{% for guest in booking.additionalGuests %}<br>{{ guest.full_name }}{% endfor %}</dd></dl></section>
    <section class="card"><h2>Price</h2><dl><dt>Rental price</dt><dd>{{ booking.rentalPriceFormatted }}</dd><dt>Initial payment</dt><dd>{{ booking.amountDueFormatted }}</dd><dt>Initial deadline</dt><dd>{{ booking.paymentDeadlineFormatted }}</dd><dt>Remaining balance</dt><dd>{{ booking.remainingBalanceFormatted }}</dd>{% if booking.remaining_balance_minor > 0 %}<dt>Balance due</dt><dd>{{ booking.balanceDueFormatted }} (15 days before arrival)</dd>{% endif %}<dt>Security deposit</dt><dd>{{ booking.securityDepositFormatted }}</dd><dt>Tourist tax</dt><dd>{{ booking.touristTaxFormatted }}</dd></dl></section>
    <section class="card span-2"><h2>Workflow actions</h2><div class="actions">
      {% if booking.status == 'AGREEMENT_DRAFT' %}<a class="button secondary" href="/admin/bookings/{{ booking.id }}/edit">Edit draft</a><form class="inline" method="post" action="/admin/bookings/{{ booking.id }}/agreement/generate"><input type="hidden" name="_csrf" value="{{ csrf }}"><button class="button" type="submit">Generate new agreement version</button></form>{% endif %}
      {% set latestAgreement = booking.agreements[0] %}
      {% if latestAgreement and latestAgreement.status != 'INVALIDATED' %}<a class="button secondary" target="_blank" rel="noopener" href="/admin/bookings/{{ booking.id }}/agreement/preview">Preview agreement</a><a class="button secondary" href="/admin/bookings/{{ booking.id }}/agreement/download">Download {% if latestAgreement.signed_pdf_path %}signed{% else %}unsigned{% endif %} PDF</a>{% endif %}
      {% if booking.status == 'AGREEMENT_DRAFT' and latestAgreement and latestAgreement.status == 'DRAFT' %}<form class="inline" method="post" action="/admin/bookings/{{ booking.id }}/agreement/send"><input type="hidden" name="_csrf" value="{{ csrf }}"><button class="button terracotta" type="submit">Send for owner signature</button></form>{% endif %}
      {% if booking.status == 'AWAITING_OWNER_SIGNATURE' or booking.status == 'AWAITING_GUEST_SIGNATURE' %}<form class="inline" method="post" action="/admin/bookings/{{ booking.id }}/agreement/resend"><input type="hidden" name="_csrf" value="{{ csrf }}"><button class="button secondary" type="submit">Resend signing invitation</button></form>{% endif %}
      {% if signingProvider == 'mock' and booking.status == 'AWAITING_OWNER_SIGNATURE' %}<form class="inline" method="post" action="/admin/bookings/{{ booking.id }}/mock-owner-sign"><input type="hidden" name="_csrf" value="{{ csrf }}"><button class="button" type="submit">Simulate owner signature</button></form>{% endif %}
      {% if signingProvider == 'mock' and booking.status == 'AWAITING_GUEST_SIGNATURE' %}<form class="inline" method="post" action="/admin/bookings/{{ booking.id }}/mock-guest-sign"><input type="hidden" name="_csrf" value="{{ csrf }}"><button class="button" type="submit">Simulate guest signature</button></form>{% endif %}
      {% if booking.status == 'AGREEMENT_SIGNED' or booking.status == 'PAYMENT_FAILED' %}<form class="inline" method="post" action="/admin/bookings/{{ booking.id }}/payment/request"><input type="hidden" name="_csrf" value="{{ csrf }}"><button class="button terracotta" type="submit">Create or resend payment request</button></form>{% endif %}
      {% if booking.status == 'CONFIRMED' and booking.remaining_balance_minor > 0 %}<form class="inline" method="post" action="/admin/bookings/{{ booking.id }}/payment/request"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="purpose" value="BALANCE"><button class="button terracotta" type="submit">Create or resend balance request</button></form>{% endif %}
    </div>{% if booking.guestUrl %}<div style="margin-top:18px"><label for="guestUrl">Secure guest page</label><div class="copy-field"><input id="guestUrl" readonly value="{{ booking.guestUrl }}"><button class="button secondary" type="button" onclick="navigator.clipboard.writeText(document.getElementById('guestUrl').value)">Copy</button></div></div>{% endif %}</section>
    <section class="card"><h2>Agreement versions</h2><div class="table-wrap"><table><thead><tr><th>Version</th><th>Status</th><th>Generated</th><th>Hash</th></tr></thead><tbody>{% for agreement in booking.agreements %}<tr><td>v{{ agreement.version }}<br><small>Template {{ agreement.template_version }}</small></td><td><span class="status">{{ agreement.status }}</span></td><td>{{ agreement.generated_at }}</td><td><small title="{{ agreement.document_hash }}">{{ agreement.document_hash | truncate(14, true, '…') }}</small></td></tr>{% else %}<tr><td colspan="4" class="muted">No agreement generated yet.</td></tr>{% endfor %}</tbody></table></div></section>
    <section class="card"><h2>Payments</h2><div class="table-wrap"><table><thead><tr><th>Stage</th><th>Amount</th><th>Due</th><th>Status</th><th>Provider</th></tr></thead><tbody>{% for payment in booking.payments %}<tr><td>{{ payment.purposeFormatted }}</td><td>{{ payment.amountFormatted }}</td><td>{{ payment.dueDateFormatted }}</td><td><span class="status {{ payment.status }}">{{ payment.status }}</span></td><td>{{ payment.provider }}</td></tr>{% else %}<tr><td colspan="5" class="muted">No payment request yet.</td></tr>{% endfor %}</tbody></table></div></section>
    <section class="card"><h2>Terms</h2><h3>Cancellation</h3><p style="white-space:pre-wrap">{{ booking.cancellation_terms }}</p><h3>Special conditions</h3><p style="white-space:pre-wrap">{{ booking.special_conditions or 'None' }}</p></section>
    <section class="card"><h2>Audit timeline</h2><ol class="timeline">{% for event in booking.events %}<li><strong>{{ event.event_type }}</strong><span>{{ event.from_status or '' }}{% if event.to_status %} → {{ event.to_status }}{% endif %}</span><small>{{ event.actor_type }} · {{ event.createdFormatted }}</small></li>{% else %}<li>No events yet.</li>{% endfor %}</ol></section>
    {% if booking.status != 'CANCELLED' and booking.status != 'EXPIRED' and booking.status != 'REFUNDED' %}<section class="card span-2"><h2>Cancel booking</h2><p class="muted">Cancelling releases the dates. Paid bookings may still require a separate Stripe refund.</p><form method="post" action="/admin/bookings/{{ booking.id }}/cancel"><input type="hidden" name="_csrf" value="{{ csrf }}"><div class="form-grid"><div class="field wide"><label for="reason">Reason</label><input id="reason" name="reason" minlength="3" required></div><div><button class="button danger" type="submit">Cancel booking</button></div></div></form></section>{% endif %}
  </div>
</main>
{% endblock %}
