# Public addresses
SITE_DOMAIN=villatullia.it
SIGN_DOMAIN=sign.villatullia.it
APP_BASE_URL=https://villatullia.it

# Villa application
COOKIE_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
OWNER_NAME=FULL_LEGAL_NAME_OF_OWNER
OWNER_EMAIL=owner@example.com
OWNER_ADDRESS=FULL_LEGAL_ADDRESS_OF_OWNER
PROPERTY_LEGAL_NAME=Villa Tullia
PROPERTY_ADDRESS=FULL_LEGAL_ADDRESS_OF_PROPERTY
DEFAULT_CURRENCY=EUR
SIGNING_HOLD_HOURS=72
CALENDAR_AVAILABILITY_URL=https://villa-calendar-sync.lankaswellproject.workers.dev/availability.json

# Start with mock/test providers. Switch SIGNING_PROVIDER only after Documenso setup.
SIGNING_PROVIDER=mock
DOCUMENSO_API_TOKEN=CREATE_AFTER_FIRST_DOCUMENSO_LOGIN
DOCUMENSO_WEBHOOK_SECRET=GENERATE_A_RANDOM_WEBHOOK_SECRET
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
BANK_TRANSFER_ENABLED=false
BANK_ACCOUNT_HOLDER=REPLACE_WITH_ACCOUNT_HOLDER
BANK_NAME=REPLACE_WITH_BANK_NAME
BANK_IBAN=REPLACE_WITH_IBAN
BANK_BIC=REPLACE_WITH_BIC

# SMTP; an existing mailbox or a free-tier SMTP account avoids a new server charge.
EMAIL_PROVIDER=smtp
EMAIL_FROM=Villa Tullia <bookings@example.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=bookings@example.com
SMTP_PASSWORD=REPLACE_ME

# Documenso self-hosting
DOCUMENSO_VERSION=v2.15.0
DOCUMENSO_POSTGRES_PASSWORD=GENERATE_A_RANDOM_DATABASE_PASSWORD_WITH_URL_SAFE_CHARACTERS
DOCUMENSO_NEXTAUTH_SECRET=GENERATE_A_RANDOM_SECRET
DOCUMENSO_ENCRYPTION_KEY=GENERATE_A_RANDOM_SECRET
DOCUMENSO_ENCRYPTION_SECONDARY_KEY=GENERATE_A_DIFFERENT_RANDOM_SECRET
DOCUMENSO_SIGNING_PASSPHRASE=GENERATE_A_SIGNING_CERTIFICATE_PASSWORD
DOCUMENSO_SMTP_FROM_NAME=Villa Tullia Signatures
DOCUMENSO_SMTP_FROM_ADDRESS=bookings@example.com
DOCUMENSO_DISABLE_SIGNUP=false
